# macfleet desktop environment variables
# Copy this file to .env and fill in your values.

# --- Tauri Auto-Updater (optional) ---
# Required for tauri-plugin-updater. See docs/recommended-plugins.md.
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- Development ---
# VITE_DEV_SERVER_PORT=1420

# Browser-only frontend development (`make dev-frontend` against `make serve`). The engine
# always requires a token, so paste the one `macfleet serve` prints on startup. Not needed
# for `make dev` (Tauri passes its own per-run token) or for the mocked e2e suite.
# VITE_MACFLEET_TOKEN=
# VITE_MACFLEET_API_BASE=http://127.0.0.1:8765
